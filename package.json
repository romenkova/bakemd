{
  "name": "bakemd",
  "version": "0.2.1",
  "description": "Bake a folder of Markdown into a static docs site",
  "keywords": [
    "docs",
    "markdown",
    "static-site",
    "cli",
    "vite"
  ],
  "license": "MIT",
  "homepage": "https://romenkova.github.io/bakemd",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/romenkova/bakemd.git"
  },
  "bugs": "https://github.com/romenkova/bakemd/issues",
  "type": "module",
  "bin": {
    "bakemd": "dist/bin/bakemd.js"
  },
  "files": [
    "dist",
    "nginx.conf"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node bin/bakemd.js dev docs",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp -R bin lib index.html dist/ && cp -R src/styles dist/src/styles",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "build:docs": "pnpm build && node dist/bin/bakemd.js build docs --out docs-dist",
    "prepublishOnly": "pnpm lint && pnpm typecheck && pnpm build"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/mulish": "5.3.0",
    "@tailwindcss/typography": "^0.5",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "clsx": "2.1.1",
    "highlight.js": "11.12.0",
    "lowlight": "3.3.0",
    "lucide-react": "1.39.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-markdown": "^10",
    "rehype-autolink-headings": "7.1.0",
    "rehype-highlight": "7.0.2",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "^4",
    "vfile": "^6.0.3",
    "vfile-matter": "^5.0.1",
    "vite": "^8.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/fira-code": "5.3.0",
    "@fontsource-variable/outfit": "5.3.0",
    "@types/node": "^22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6",
    "typescript-eslint": "^8.69.0"
  }
}
